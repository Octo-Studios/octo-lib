{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "it.hurts.shatterbyte.${mod_id}.fabric.ShatterLibFabric"
    ],
    "client": [
      "it.hurts.shatterbyte.${mod_id}.fabric.ShatterLibFabricClient"
    ]
  },
  "mixins": [
    "shatterlib-common.mixins.json",
    "shatterlib-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": ">=1.21.11",
    "java": ">=21",
    "architectury": ">=19.0.1",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
